.idea
.env

models
# Template assets follow the model weights: fetched or mounted, never
# committed. A library of scenes would bloat every clone and every image build.
templates
temp
__pycache__

environ
*environ*

models
Python_3_12_0venv

*.jpeg
*.npy
.env.backup-*

# Firebase functions create their own venv on deploy
venv/
firebase/functions/venv/
.firebase/

# Nuitka standalone build output. `desktop.dist` is ~600 MB — Qt plugins are
# bundled with --include-qt-plugins=all until there is a build known to work
# and trimming can be verified. `desktop.build` is the C intermediate.
build/
nuitka-crash-report.xml

# Sweep output — a measurement artefact, not source.
# Lever sweep output. A measurement of one pod session on one card, not a
fact about the code — and the readings that matter get written into
CLAUDE.md rather than left in a JSON nobody opens.
sweep*.json

# Measurement clips recorded by tools/record_clip.py. They are written to the
# repo root because that is where they are wanted, which makes it easy to
# commit one by accident — a 78 MB clip reached origin exactly that way. The
# examples in .github/examples are the deliberate exception and stay tracked.
/clip*.mp4
/*.mkv
/*.mov
/*.avi
