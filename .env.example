# Phantom Pipeline — Environment Variables
# Copy this file to .env and customize as needed.
# These are loaded automatically at startup via python-dotenv.

# Execution provider: cpu, cuda, rocm, dml
EXECUTION_PROVIDER=cuda

# WebSocket API server port
API_PORT=9000

# Logging level: debug, info, warning, error
LOG_LEVEL=info

# WebSocket URL for desktop to connect to pipeline
# Local development: ws://localhost:9000/ws
# RunPod remote: set automatically by runpod/orchestrator.py start
PHANTOM_API_URL=ws://localhost:9000/ws

# RunPod orchestrator — only needed if using runpod/orchestrator.py
# Get your API key: RunPod dashboard → Settings → API Keys
RUNPOD_API_KEY=
# Pod ID — set automatically by orchestrator on first deploy, or paste from dashboard
RUNPOD_POD_ID=

# Deploy mode: ssh (development) or docker (production)
#   ssh:    orchestrator SSHes in, clones repo, installs deps, starts the
#           pipeline under nohup (log: /workspace/phantom-pipeline.log)
#   docker: pipeline auto-starts from the baked Docker image, no SSH needed
RUNPOD_DEPLOY_MODE=ssh

# Datacenters to try, in priority order, each paired with its own network
# volume — volumes are datacenter-local, so a fallback region needs its own.
# Find both: RunPod dashboard → Storage.
#   RUNPOD_DATACENTERS=EU-RO-1:<volume-id>,US-KS-2:<other-volume-id>
RUNPOD_DATACENTERS=

# Legacy single-datacenter form. Only read when RUNPOD_DATACENTERS is empty.
#   RUNPOD_DATACENTER_ID=EU-RO-1
RUNPOD_DATACENTER_ID=

# GPU selection. Leave RUNPOD_GPU_TYPES unset to auto-discover: the orchestrator
# queries RunPod, filters by VRAM and price, drops GPUs whose compute capability
# exceeds what the image's torch/ONNX builds support, and tries the fastest
# first. Setting it pins an exact list and disables all of that — the
# architecture filter and the RUNPOD_MIN_GPU_PERF tier included, since naming
# cards is already a statement about which ones are acceptable — so a pinned
# list goes stale as RunPod's fleet changes.
# Use RunPod's exact display names if you do pin.
#   RUNPOD_GPU_TYPES=NVIDIA GeForce RTX 3090,NVIDIA RTX A4000,NVIDIA GeForce RTX 4090
RUNPOD_GPU_TYPES=
RUNPOD_MIN_VRAM=16
RUNPOD_MAX_PRICE=1.00

# Speed floor, as a rank in orchestrator.py's _GPU_PERF table. At 85 the tier
# is the RTX 4090, H200, H100, RTX 6000 Ada and L40S — and in practice three of
# those, since the H-series usually breaches RUNPOD_MAX_PRICE first.
#
# Without a floor, auto-discovery silently accepts a card at the bottom of the
# eligible range when the top one is busy: a whole measurement session was
# spent on an L4 (rank 34) that way, and every number in it is against an
# architecture nothing else was measured on.
RUNPOD_MIN_GPU_PERF=85

# When nothing in the tier is free, wait this many seconds — retrying the whole
# candidate list every minute — before giving up. Waiting is free: billing
# starts when a pod runs, not while you queue for one.
RUNPOD_GPU_WAIT=300

# What happens when that wait expires. Unset (the default) fails, which is what
# a measurement session wants: numbers from two architectures are not a
# comparison. Set it to true for a customer-facing session, where a slower card
# beats no service at all.
RUNPOD_GPU_FALLBACK=

# Pod image and disks — used when deploying a fresh pod
# ssh mode: use a generic RunPod base image (setup happens over SSH)
# docker mode: use your custom image with pipeline baked in
RUNPOD_IMAGE=runpod/pytorch:2.2.0-py3.10-cuda12.1.1-devel-ubuntu22.04
RUNPOD_CONTAINER_DISK=20
# Sized for models plus batch scratch. Batch video extracts every frame as
# lossless PNG — roughly 4 MB per 1080p frame, so about 36 GB for five minutes
# at 30fps. Scratch defaults to /workspace/tmp (this volume) rather than the
# container disk, so raise this before running long batch jobs.
RUNPOD_VOLUME_DISK=20
# Network volume ID — attach existing /workspace so models survive pod recreation
# Legacy form, paired with RUNPOD_DATACENTER_ID above. Ignored when
# RUNPOD_DATACENTERS is set.
RUNPOD_NETWORK_VOLUME_ID=

# Billing protection. The orchestrator forwards these into the pod, and the
# pipeline's own timer calls runpod.stop_pod() when the limit is reached — so an
# abandoned session is capped even with no desktop connected. 0 disables.
RUNPOD_MAX_UPTIME=120
RUNPOD_STOP_WARNING=5

# SSH mode only — ignored in docker mode
# Must be unencrypted — the orchestrator loads it without a passphrase prompt.
RUNPOD_SSH_KEY_PATH=~/.ssh/id_ed25519
# Repo URL for auto-cloning on first deploy — include token for private repos
# Public:  https://github.com/khonello/Phantom.git
# Private: https://<token>@github.com/khonello/Phantom.git
RUNPOD_REPO_URL=https://github.com/khonello/Phantom.git

# ── Pipeline settings, forwarded to the pod ──────────────────────────────────
# Anything set here is copied into the pod environment by orchestrator.py, so
# `start` produces a configured pipeline rather than a default one. All are
# optional; each is read by pipeline/core.py as an argparse default.

# Face swap model. Also selects its realism profile — see
# pipeline/services/swapper_models.py. Leave unset for inswapper_128.
#   inswapper_128 | hyperswap_1a_256 | hyperswap_1b_256 | hyperswap_1c_256
SWAPPER_MODEL=

# Realism. Normally left unset so the model profile and quality preset decide;
# set them to override while sweeping values against a fixed clip.
# gpen_bfr_256 (default) | codeformer | gpen_bfr_512 | gfpgan.
# The number is the crop the model restores at, and it is the whole cost:
# 5.4ms at 256 against 29.4ms at 512 on a 4090. Only codeformer has a
# fidelity weight, so ENHANCER_WEIGHT does nothing under the others.
ENHANCER_MODEL=
ENHANCER_WEIGHT=
ENHANCE_STRENGTH=
ALIGNED_SIZE=
# Restoration is the most expensive stage and the only one whose cost ignores
# how big the face is. RESTORE_SIZE asks for a smaller FFHQ crop (a model with
# fixed inputs overrides it and says so); RESTORE_MIN_FACE skips restoration
# below a face size in px, shorter side.
RESTORE_SIZE=
RESTORE_MIN_FACE=
TEMPORAL_ALPHA=
COLOR_STRENGTH=

# Input guards. GUARD_OBSERVE evaluates and records every guard without any of
# them acting — a session that enforces cannot measure itself, because a guarded
# frame emits the held frame and stops being a sample of the camera.
GUARDS=
GUARD_OBSERVE=
GUARD_REPORT=

# Measurement. DEBUG_FRAMES_DIR writes lossless (input, output) pairs for
# tools/compare_frames.py. Roughly 1.4 MB per pair at 640x360, so raise the
# stride for anything longer than a short clip.
DEBUG_FRAMES_DIR=
DEBUG_FRAMES_STRIDE=
DEBUG_FRAMES_LIMIT=

# Inference speed. All default off, so leaving these blank is bit-identical to
# the behaviour before they existed.
#
# CUDA_GRAPHS changes no numerics — it removes per-kernel launch overhead on the
# fixed-shape models (CodeFormer, XSeg, the swapper) and is ignored for the
# detector, whose input size varies with the preset.
#
# FP16 loads a converted -fp16.onnx copy where one exists; make them with
# tools/convert_fp16.py. It is the largest single win and the only one of these
# that can change what the output looks like, so A/B it with --debug-frames and
# tools/compare_frames.py rather than trusting the latency number.
#
# TRT routes through TensorRT. Engines build in minutes and cache under
# /workspace/trt-cache, keyed by GPU, library versions, weights and precision,
# so each architecture pays that once ever. TRT_GPUS names the cards fast enough
# to be worth the build — anything else runs on CUDA and says so.
FP16=
CUDA_GRAPHS=
TRT=
TRT_GPUS=

# CUDA_STREAMS puts host<->device copies on their own stream so a transfer can
# overlap compute. Ignored where CUDA graphs are active — a captured graph
# replays a fixed sequence against fixed buffers, and a copy outside its stream
# is exactly the ordering assumption capture makes.
#
# ASYNC_ENCODE moves the JPEG encode off the pipeline thread onto the sender
# thread that was already waiting on the network. It also stops encoding frames
# nobody sees: the sender drains to the newest frame, so anything encoded at
# emit time and then overtaken was wasted work.
CUDA_STREAMS=
ASYNC_ENCODE=

# Batch scratch root. Defaults to /workspace/tmp on a pod, system temp locally.
PHANTOM_TEMP_DIR=

# ── Access codes ────────────────────────────────────────────────────────────
# Base URL of the deployed Cloud Functions. The desktop calls /session on every
# launch and /redeem once the pipeline is running.
#   blank  -> no gate at all (local development)
#   mock   -> gate is shown and answered in-process, no Firebase needed
#   a URL  -> the real thing:
#             https://<region>-<project-id>.cloudfunctions.net
#
# Only the exact literal "mock" (or demo/local/offline) triggers the in-process
# answer, so a real URL that happens to be down still reports as unreachable
# rather than quietly letting anyone in.
PHANTOM_AUTH_URL=

# Mock mode only: shorten the hour so the countdown and expiry can be watched
# without waiting. Ignored against a real URL.
PHANTOM_AUTH_MOCK_MINUTES=60
